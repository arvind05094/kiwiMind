# Azure OpenAI (Set to true if using Azure instead of Groq)
AzureOpenAI__Enabled=false

# Database Configuration (Neon PostgreSQL with pgvector)
ConnectionStrings__Default="Host=localhost;Database=kiwimind;Username=postgres;Password=your_local_password;Ssl Mode=Prefer"

# JWT Authentication
Jwt__Secret="your_local_super_secret_key_minimum_32_characters_long"
Jwt__Issuer="KiwiMind"
Jwt__Audience="KiwiMind"

# Groq AI Configuration
Groq__ApiKey="gsk_your_groq_api_key_here"
Groq__Model="openai/gpt-oss-120b"

# S3 Object Storage (Supabase)
S3Storage__ServiceUrl="https://your_project_id.supabase.co/storage/v1/s3"
S3Storage__AccessKey="your_s3_access_key"
S3Storage__SecretKey="your_s3_secret_key"
S3Storage__BucketName="kiwimind-bucket"

# CORS Settings
Cors__AllowedOrigins__0="http://localhost:5173"